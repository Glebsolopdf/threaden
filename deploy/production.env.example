LIVEKIT_PUBLIC_URL=wss://livekit.example.com
LIVEKIT_API_KEY=replace-with-a-random-production-key
LIVEKIT_API_SECRET=replace-with-a-long-random-production-secret
ROOM_TTL=12h
LIVEKIT_TOKEN_TTL=30m
SESSION_TTL=168h
SESSION_IDLE_TTL=24h
SESSION_COOKIE_SECURE=true
MAX_ROOM_PARTICIPANTS=16
CORS_ALLOWED_ORIGINS=https://threaden.example.com
TRUSTED_PROXIES=127.0.0.1,::1
RATE_LIMIT_BUCKET_TTL=6h
MAX_MESSAGE_RUNES=2000
MAX_MESSAGE_LINKS=4
MAX_MESSAGE_MENTIONS=12
INACTIVE_GROUP_TTL=168h
GROUP_DELETE_GRACE=24h
GROUP_CLEANUP_INTERVAL=1h
GROUP_CLEANUP_BATCH=20
GROUP_CLEANUP_DRY_RUN=true
LOW_DISK_MIN_FREE_BYTES=5368709120
LOW_DISK_CHECK_INTERVAL=5m
