port: 7880

rtc:
  use_external_ip: true
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 60000

# Copy this file to livekit.yaml for deployment and replace both placeholders.
# Never commit deploy/livekit.yaml.
keys:
  REPLACE_WITH_LIVEKIT_API_KEY: REPLACE_WITH_LIVEKIT_API_SECRET

turn:
  enabled: false
  # Configure these only when TURN is required:
  # domain: turn.example.com
  # udp_port: 3478
  # tls_port: 5349
  # cert_file: /etc/letsencrypt/live/turn.example.com/fullchain.pem
  # key_file: /etc/letsencrypt/live/turn.example.com/privkey.pem
